    "videos": [
      {
        "id": "tt29549403:1:1",
        "title": "El hijo de Urrao",
        "season": 1,
        "episode": 1,
        "overview": "Rigo, ciclista aficionado, llega a pasar unos días en Urrao, su tierra. Allí enfrenta a Evaristo, un usurero que busca quedarse con la casa que les dejó su difunto padre. Giuseppe, un mánager italiano, contacta a Rigo y le propone correr en Europa, pero su sueño se ve truncado por una visa negada. Rigo se reencuentra con Michelle, su eterno amor.",
        "released": "2023-10-08",
        "thumbnail": "https://image.tmdb.org/t/p/w500/45EoLSmLYlIS6Panrvn0sVh3Jxm.jpg"
      },
      {
        "id": "tt29549403:1:2",
        "title": "El amor llega de golpe",
        "season": 1,
        "episode": 2,
        "overview": "Tras su primer obstáculo en el ciclismo, Rigo recuerda los años en los que vivía su padre y la forma como el amor llegó a su vida.",
        "released": "2023-10-08",
