      "ratings": {
        "tmdb": {
          "rating": "7.6"
        }
      }
    },
    "videos": [
      {
        "id": "tt8225204:1:1",
        "title": "Wen Kamuy",
        "season": 1,
        "episode": 1,
        "overview": "Al regresar de combatir en la guerra ruso-japonesa, Sugimoto se ve en la necesidad de encontrar oro para cumplir una promesa. Entonces, le cuentan una historia que puede tener mucha relevancia.",
        "released": "2018-04-09",
        "thumbnail": "https://image.tmdb.org/t/p/w500/zPfELAqB3LP6ZrCalZB1wR7ET1W.jpg"
      },
      {
        "id": "tt8225204:1:2",
        "title": "Sin rostro",
        "season": 1,
        "episode": 2,
        "overview": "Sugimoto comienza la búsqueda de los demás presos con los tatuajes con la compañía de Asirpa, pero pronto comprobará que no es el único que los está buscando.",
        "released": "2018-04-16",
        "thumbnail": "https://image.tmdb.org/t/p/w500/uI4rmqnYQlSUn77Wwqpq4MoTmD4.jpg"
      },
      {
        "id": "tt8225204:1:3",
        "title": "Kamuy Moshiri",
        "season": 1,
        "episode": 3,
        "overview": "Sugimoto va familiarizándose poco a poco sobre las costumbres de los ainus, no solo de su comida, sino también de su religión, sus creencias y sus tradiciones.",
        "released": "2018-04-23",
        "thumbnail": "https://image.tmdb.org/t/p/w500/mmNDxevfpmiE59HjhcjmjN537zu.jpg"
      },
      {
        "id": "tt8225204:1:4",
        "title": "La muerte",
        "season": 1,
        "episode": 4,
        "overview": "Sugimoto tendrá muchos problemas con el ejército debido a su búsqueda de los hombres con los tatuajes que le llevarán hasta el oro escondido.",
        "released": "2018-04-30",
        "thumbnail": "https://image.tmdb.org/t/p/w500/6zQIOfhsnAJDV8HJPFbvcsPVIRw.jpg"
      },
      {
        "id": "tt8225204:1:5",
        "title": "¡A correr!",
        "season": 1,
        "episode": 5,
        "overview": "La vida de Sugimoto corre muchísimo peligro al estar apresado por la gente del ejército. Por fortuna, Asirpa sigue convencida de que podrá salvarlo de su cautiverio.",
        "released": "2018-05-07",
        "thumbnail": "https://image.tmdb.org/t/p/w500/ccp8uFT4ckN6cpCriyALFhasCV2.jpg"
      },
      {
        "id": "tt8225204:1:6",
        "title": "Alma de cazador",
        "season": 1,
        "episode": 6,
        "overview": "Sugimoto sigue obsesionado con rematar al ciervo al que no pudo matar, pero por otro lado hay otro cazador en el bosque que pretende acabar con un lobo muy peligroso.",
        "released": "2018-05-14",
        "thumbnail": "https://image.tmdb.org/t/p/w500/iklDO2OcFpe0pO0wbNr35UvcQxS.jpg"
      },
      {
        "id": "tt8225204:1:7",
        "title": "Complicaciones",
        "season": 1,
        "episode": 7,
        "overview": "Nihei y Sugimoto están frente a frente, uno con la intención de sobrevivir y el otro con la intención de acabar con ese lobo blanco que resulta ser Retar.",
        "released": "2018-05-21",
        "thumbnail": "https://image.tmdb.org/t/p/w500/htAO55fZla6nq73bbe7HXTIUQvq.jpg"
      },
      {
        "id": "tt8225204:1:8",
        "title": "Ojos de asesino",
        "season": 1,
        "episode": 8,
        "overview": "Shiraishi se mete en un aprieto terrible tras encontrarse con el mismísimo Hijikata. Eso provocará que Sugimoto y el resto deban ir a por otro de los hombres con tatuaje, un asesino.",
        "released": "2018-05-28",
        "thumbnail": "https://image.tmdb.org/t/p/w500/rBC2nvbC3cAz7AOsRkYLZx0HDU8.jpg"
      },
      {
        "id": "tt8225204:1:9",
        "title": "Resplandor",
        "season": 1,
        "episode": 9,
        "overview": "Sugimoto no es consciente de ello, pero está junto a él el despiadado asesino al que estaba buscando para arrebatarle el tatuaje.",
        "released": "2018-06-04",
        "thumbnail": "https://image.tmdb.org/t/p/w500/9ogY0u2HSLuJMkMYlojsAhrtfcK.jpg"
      },
      {
        "id": "tt8225204:1:10",
        "title": "Te arrastraré conmigo",
        "season": 1,
        "episode": 10,
        "overview": "El ejército está persiguiendo a Tanigaki para acabar con él, pero hará todo lo posible para evitar que eso ocurra.",
        "released": "2018-06-11",
        "thumbnail": "https://image.tmdb.org/t/p/w500/960iAePoyNcXy99mugTwziJP9tC.jpg"
      },
      {
        "id": "tt8225204:1:11",
        "title": "¡Reunión en el hotel de los asesinatos!",
        "season": 1,
        "episode": 11,
        "overview": "Sugimoto y sus compañeros llegan a un hotel de Sapporo para descansar. Allí se están produciendo unos asesinatos misteriosos y, si fuera poco, Ushiyama también se hospedará allí.",
        "released": "2018-06-18",
        "thumbnail": "https://image.tmdb.org/t/p/w500/h2AoRsnRlP9frIrnSQosEF0N3Y.jpg"
      },
      {
        "id": "tt8225204:1:12",
        "title": "El zorro engaña",
        "season": 1,
        "episode": 12,
        "overview": "Han llegado rumores sobre una supuesta adivina. Ese hecho es más que suficiente para que Shiraishi tome todo su dinero y vaya con ella a apostar a las carreras de caballos.",
        "released": "2018-06-25",
        "thumbnail": "https://image.tmdb.org/t/p/w500/hI9pIrcarjYpOHhpIcTkdK46bWd.jpg"
      },
      {
        "id": "tt8225204:2:1",
        "title": "Edogai-kun",
        "season": 2,
        "episode": 1,
        "overview": "El teniente Tsurumi está buscando a un taxidermista en concreto que es bastante particular: Edogai. Le hará una petición muy especial relacionada con los tatuajes.",
        "released": "2018-10-08",
        "thumbnail": "https://image.tmdb.org/t/p/w500/cssjCBUp76r3KiilXz7oIYqrOY3.jpg"
      },
      {
        "id": "tt8225204:2:2",
        "title": "Imitaciones",
        "season": 2,
        "episode": 2,
        "overview": "A petición del teniente Tsurumi, Edogai trabajará en la recreación de las pieles tatuadas. El problema reside en que hay gente que quiere su conocimiento... o su vida",
        "released": "2018-10-15",
        "thumbnail": "https://image.tmdb.org/t/p/w500/ggRb4iRFIckGKJWxLIchlzukFYK.jpg"
      },
      {
        "id": "tt8225204:2:3",
        "title": "Hablemos del pasado",
        "season": 2,
        "episode": 3,
        "overview": "Mientras Sugimoto y los demás inspeccionan la casa de Edogai, reciben una desagradable visita, por lo que tendrán que escapar junto a Hijikata.",
        "released": "2018-10-22",
        "thumbnail": "https://image.tmdb.org/t/p/w500/taGRSZ2QFP6blpU1KFqXz6jA9L9.jpg"
      },
      {
        "id": "tt8225204:2:4",
        "title": "¡Infiltración en la Séptima División de Asahikawa!",
        "season": 2,
        "episode": 4,
        "overview": "La Séptima División ha apresado a Shiraishi y piensa llevárselo, pero ni Sugimoto ni nadie quiere permitirlo, así que tendrán que idear un modo de rescatarlo.",
        "released": "2018-10-29",
        "thumbnail": "https://image.tmdb.org/t/p/w500/hKQw9jAFvMvwmCWvBOaTlwW9fH3.jpg"
      },
      {
        "id": "tt8225204:2:5",
        "title": "Entrañas",
        "season": 2,
        "episode": 5,
        "overview": "El plan para rescatar a Shiraishi es muy elaborado y está todo muy bien pensado, pero ¿bastará para llevárselo sin levantar sospechas?",
        "released": "2018-11-05",
        "thumbnail": "https://image.tmdb.org/t/p/w500/ltwukVOrxvD5t6mtWnPNxV4O8DB.jpg"
      },
      {
        "id": "tt8225204:2:6",
        "title": "Ani Nekko",
        "season": 2,
        "episode": 6,
        "overview": "Cuando Sugimoto desciende de Daisetsuzan, la fila de Tanigaki recibe un telegrama en cierta ciudad. Tanigaki, que sabe que la frontera se está preparando para los racimos de la muerte y rasga el papel de hacer que Ashigepa vuelva a su corazón. En ese momento, mi pasado que quería un papel en su mente se aclaró y el recuerdo de la noche que le contó al teniente de Tsurumi, el teniente revive.",
        "released": "2018-11-12",
        "thumbnail": "https://image.tmdb.org/t/p/w500/13DcHdxbnVLOUvJNACuX2Y9isX8.jpg"
      },
      {
        "id": "tt8225204:2:7",
        "title": "Kamuy hopunire",
        "season": 2,
        "episode": 7,
        "overview": "Sugimoto, Asirpa y compañía llegan a una aldea donde están celebrando el kamuy hopunire. Debido a eso, Asirpa aprovechará para explicarle a Sugimoto qué entienden los ainu por \"kamuy\".",
        "released": "2018-11-19",
        "thumbnail": "https://image.tmdb.org/t/p/w500/11BOtKOacLsq7eFvtngzRBZWkhh.jpg"
      },
      {
        "id": "tt8225204:2:8",
        "title": "Ojos azules",
        "season": 2,
        "episode": 8,
        "overview": "Asirpa aprovecha un momento de confusión para separarse y hablar a solas con Inkarmat acerca de la identidad de su padre... y también d",
        "released": "2018-11-26",
        "thumbnail": "https://image.tmdb.org/t/p/w500/uEgbRGRBiQFWk6lzhJjdPRM7dIJ.jpg"
      },
      {
        "id": "tt8225204:2:9",
        "title": "El sonido del ataque sorpresa",
        "season": 2,
        "episode": 9,
        "overview": "Corren rumores por la zona de que hay un grupo de bandidos que atacan de noche y agarran a todos desprevenidos. Mientras Sugimoto y compañía se informan del asunto recibirán una desagradable visita.",
        "released": "2018-12-03",
        "thumbnail": "https://image.tmdb.org/t/p/w500/reYeC5U14T9LU4ZOTRa3LHB0SQe.jpg"
      },
      {
        "id": "tt8225204:2:10",
        "title": "La noche de luna nueva",
        "season": 2,
        "episode": 10,
        "overview": "El único modo de averiguar si es cierto que Sin Rostro es el padre de Asirpa o no es yendo a verlo cara a cara a la prisión Abashiri, así que hay que planear una infiltración en la prisión.",
        "released": "2018-12-10",
        "thumbnail": "https://image.tmdb.org/t/p/w500/n9yQpsputmVaj1EzV7gW0iSBvPD.jpg"
      },
      {
        "id": "tt8225204:2:11",
        "title": "Invasión violenta",
        "season": 2,
        "episode": 11,
        "overview": "La situación en Abashiri no es la deseada. El Sin Rostro que encuentran en la celda parece ser que no es el de verdad y alerta a los guardias. Si eso fuera poco, Tsurumi entra en acción.",
        "released": "2018-12-17",
        "thumbnail": "https://image.tmdb.org/t/p/w500/xEU3YaCYutxDZ57rhJ2o4YsaZfh.jpg"
      },
      {
        "id": "tt8225204:2:12",
        "title": "Concordia",
        "season": 2,
        "episode": 12,
        "overview": "Sugimoto tiene delante de él a Sin Rostro, y parece ser el auténtico, puesto que reconoce el makiri que le hizo a Asirpa. ¿Qué le dirá? ¿Mató él a los ainu?",
        "released": "2018-12-24",
        "thumbnail": "https://image.tmdb.org/t/p/w500/1DJvNpHSMcxeVHY4ha9xgpPljQI.jpg"
      },
