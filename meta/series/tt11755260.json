    "videos": [
      {
        "id": "tt11755260:1:1",
        "title": "Wang Ling Vence al Sapo Gigante Otra Vez",
        "season": 1,
        "episode": 1,
        "overview": "Wang Ling es un novato en la escuela de Songhai. Con solo 5 puntos de fuerza espiritual, tendrá que enfrentarse a algunos problemas.",
        "released": "2020-01-18",
        "thumbnail": "https://image.tmdb.org/t/p/w500/zuelzwXViiKfszwACZ4ijKxqIel.jpg"
      },
      {
        "id": "tt11755260:1:2",
        "title": "Un Digno Candidato a Presidente de la Clase",
        "season": 1,
        "episode": 2,
        "overview": "Sun Rong y Chen Chao compiten por el puesto de presidente estudiantil de la clase de élite. ¿Podrá Sun Rong lograrlo con un encantamiento?",
        "released": "2020-01-18",
        "thumbnail": "https://image.tmdb.org/t/p/w500/keRpo5VIfRGuUMvKOhqZwFyTLmF.jpg"
      },
      {
        "id": "tt11755260:1:3",
        "title": "Cómo Hacer Píldoras de Vitalidad",
        "season": 1,
        "episode": 3,
        "overview": "En la clase de élite, los estudiantes aprenden a hacer píldoras de vitalidad. Aunque los demás usan hornos o calderos extravagantes, Wang Ling decide usar un microondas.",
        "released": "2020-01-18",
        "thumbnail": "https://image.tmdb.org/t/p/w500/lw9Zwh0pOR1iLdNjWsQaLPZpVO7.jpg"
      },
      {
        "id": "tt11755260:1:4",
        "title": "La Chica que me Espera en la Puerta para Tener una Cita",
        "season": 1,
        "episode": 4,
        "overview": "Sun Rong invita a Wang Ling a una cita especial. Pero lo que ella no sabe es que dos asesinos intentarán aguar su diversión.",
        "released": "2020-01-18",
        "thumbnail": "https://image.tmdb.org/t/p/w500/aiYLyLPJEeFWpMkOKmv5eyPzX27.jpg"
      },
      {
        "id": "tt11755260:1:5",
        "title": "Los Tres Hermanos de la Liga de las Sombras",
        "season": 1,
        "episode": 5,
        "overview": "Los asesinos vuelven al ataque en la escuela. Pero esta vez la escuela está preparada para enfrentarse a cualquier amenaza. Sin embargo, el ataque de los tres hermanos es demasiado poderoso.",
        "released": "2020-01-25",
        "thumbnail": "https://image.tmdb.org/t/p/w500/37ECsqA3Xee8S7SEjdeIhia0Y4r.jpg"
      },
      {
        "id": "tt11755260:1:6",
        "title": "B++ es el Mejor Lenguage del Mundo",
        "season": 1,
        "episode": 6,
        "overview": "Wang Ling sale primero en la prueba nacional de poder y decide infiltrarse en el sistema para cambiar su puntaje.",
        "released": "2020-02-01",
        "thumbnail": "https://image.tmdb.org/t/p/w500/8XUgaeeQsoAxTadzObPoAwbbhvM.jpg"
      },
      {
        "id": "tt11755260:1:7",
        "title": "18 Consejos para el Cuidado de tu Espada Espiritual",
        "season": 1,
        "episode": 7,
        "overview": "Wang Ling participará de la competencia interescolar de espadas junto a sus amigos frente a su rival, la escuela 59.",
        "released": "2020-02-08",
        "thumbnail": "https://image.tmdb.org/t/p/w500/lBxIkJBZutv5af5d6pKRLeipPb.jpg"
      },
      {
        "id": "tt11755260:1:8",
        "title": "El Equipo Perfecto",
        "season": 1,
        "episode": 8,
        "overview": "Wang Ling no quiere participar en la competencia y busca el momento perfecto para fingir que se siente mal. Cuando su amuleto está a punto de romperse, la salud de Wang Ling corre el riesgo de agravarse de verdad.",
        "released": "2020-02-15",
        "thumbnail": "https://image.tmdb.org/t/p/w500/sJusr83xCFB3mSg3jyKRfHMv8M1.jpg"
      },
      {
        "id": "tt11755260:1:9",
        "title": "La Jefa de la Liga de las Sombras",
        "season": 1,
        "episode": 9,
        "overview": "Wang Ling necesita que su padre acuda a ayudarlo o el desastre será inminente. Mientras espera, Wang Ling se topa con una peligrosa líder en los pasillos de la escuela 59.",
        "released": "2020-02-22",
        "thumbnail": "https://image.tmdb.org/t/p/w500/bxgctCLqLPqjFL7C0TvoTcUIbXD.jpg"
      },
      {
        "id": "tt11755260:1:10",
        "title": "¡Es Hora de Partir, Viejo Chofer!",
        "season": 1,
        "episode": 10,
        "overview": "El amuleto se rompe y ahora Wang Ling debe controlar sus emociones por sí mismo. Mientras tanto, Sun Rong está lista para ayudar a su amigo más importante.",
        "released": "2020-02-29",
        "thumbnail": "https://image.tmdb.org/t/p/w500/edVbrCYBVCWyB74zymwWaYLXHxF.jpg"
      },
      {
        "id": "tt11755260:1:11",
        "title": "Danza del Océano",
        "season": 1,
        "episode": 11,
        "overview": "Wang Ling intenta mantener un perfil bajo, ahora que su amuleto está roto. En el altar de agua, Sun Rong se enfrenta a Tang Jingze.",
        "released": "2020-03-07",
        "thumbnail": "https://image.tmdb.org/t/p/w500/fueBEwP8Rc08eqf4G4TBYPi8uP3.jpg"
      },
      {
        "id": "tt11755260:1:12",
        "title": "El Perro es el Mejor Amigo del Hombre",
        "season": 1,
        "episode": 12,
        "overview": "Cuando Wang Ling comienza a perder el control, Sapito salta sobre él y absorbe su energía negativa. En ese momento, sucede algo sorprendente que le da a Wang Ling la capacidad de usar su fuerza sin restricciones.",
        "released": "2020-03-14",
        "thumbnail": "https://image.tmdb.org/t/p/w500/fVPFzkoXn7nymqd4eCTDvGL6ExK.jpg"
      },
      {
        "id": "tt11755260:1:13",
        "title": "¡A Arder!",
        "season": 1,
        "episode": 13,
        "overview": "La espada espiritual de Tang Jingze se enfrenta a Sun Rong y destruye su arma. El padre de Wang Ling implora que detengan la competencia antes de que alguien salga herido.",
        "released": "2020-03-21",
        "thumbnail": "https://image.tmdb.org/t/p/w500/b6I1tWdUNw7O03eQtwH2fpsHe0P.jpg"
      },
      {
        "id": "tt11755260:1:14",
        "title": "Casi Perfecto",
        "season": 1,
        "episode": 14,
        "overview": "La competencia llega a su fin. La líder de la Liga de las Sombras ataca y Wang Ling finalmente pierde el control.",
        "released": "2020-03-21",
        "thumbnail": "https://image.tmdb.org/t/p/w500/FbFIsLoYa0euAgyrzUrFWvrC9o.jpg"
      },
      {
        "id": "tt11755260:1:15",
        "title": "El Rey Inmortal Está Perdido",
        "season": 1,
        "episode": 15,
        "overview": "Wang Ling se da cuenta rápidamente de su error: no haber detenido antes a la líder de la Liga de las Sombras. Entonces, decide arriesgarse una vez más.",
        "released": "2020-03-28",
        "thumbnail": "https://image.tmdb.org/t/p/w500/4ZgpyHhlysKrmMK9K9TDiFllnbc.jpg"
